// 全站配色与排版，只需改这里
#let accent = rgb("#B52323") // 标题：默认深红；可换 #174A70 深蓝 / #245C48 墨绿
#let ink = rgb("#222222") // 正文，不建议浅于 #333333
#let muted = rgb("#626262") // 日期与辅助文字
#let icon-color = rgb("#333333") // 自带SVG需同时修改文件内fill；图片不受文字颜色控制
#let card-bg = rgb("#F2F2F2")
#let body-size = 10.5pt
#let leading = 6pt
#let page-margin = (x: 11mm, top: 10mm, bottom: 10mm)
